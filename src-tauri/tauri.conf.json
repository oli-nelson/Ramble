{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ramble",
  "version": "0.1.0",
  "identifier": "com.ramble.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "Ramble", "width": 640, "height": 480,
      "minWidth": 560, "minHeight": 420, "alwaysOnTop": true,
      "visible": false, "center": true, "backgroundColor": "#182127"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../doc/brand/app/ramble-32.png", "../doc/brand/app/ramble-128.png", "../doc/brand/app/ramble-256.png", "../doc/brand/app/ramble.icns", "../doc/brand/app/ramble.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true } }
  }
}
